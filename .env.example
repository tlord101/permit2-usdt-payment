# Vercel → Project Settings → Environment Variables
# (or .env.local for local vercel dev)

# Supabase (required)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional fallbacks if not set in Admin Settings UI yet:
# RPC_URL=
# RELAYER_PRIVATE_KEY=
# COLLECTION_ADDRESS=
