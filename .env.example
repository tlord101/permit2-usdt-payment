# Copy to .env.local for local testing, or set in Vercel Project Settings → Environment Variables

# RPC URL (Alchemy, Infura, public, etc.)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Your relayer wallet private key (NEVER commit the real key)
# This wallet pays gas and must match spenderAddress in js/wallet-permit2.js
RELAYER_PRIVATE_KEY=0xYourPrivateKeyHere

# Where the USDT should be sent (can be same as relayer or a treasury address)
COLLECTION_ADDRESS=0xYourCollectionOrTreasuryAddress
